{
  "client": "opencode",
  "server": {
    "listen": "127.0.0.1:8787"
  },
  "routing": {
    "strategy": "failover"
  },
  "upstreams": [
    {
      "name": "direct",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "priority": 10,
      "weight": 100,
      "enabled": true
    }
  ]
}
