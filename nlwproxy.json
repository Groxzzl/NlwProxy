{
  "client": "opencode",
  "server": {
    "listen": "127.0.0.1:8787",
    "local_token_env": "NLW_PROXY_LOCAL_TOKEN",
    "strict_opencode_client": true,
    "max_body_bytes": 20971520
  },
  "routing": {
    "strategy": "round_robin"
  },
  "upstreams": [
    {
      "name": "ReffaUnlimited",
      "base_url": "https://api.opencode.ai/v1",
      "api_key_env": "REFFAUNLIMITED_API_KEY",
      "priority": 10,
      "weight": 1,
      "enabled": true
    }
  ]
}
